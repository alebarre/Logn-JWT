# DATABASE
POSTGRES_DB=login_jwt_db
POSTGRES_USER=login_jwt_user
POSTGRES_PASSWORD=login_jwt_pass
POSTGRES_PORT=5432

# SPRING DATABASE
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# JWT CONFIG
JWT_SECRET=uma-chave-secreta-bem-grande-e-segura-para-jwt
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=1209600000
