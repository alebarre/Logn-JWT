# =====================================================================
# Arquivo unico de variaveis de ambiente do projeto (backend + frontend)
# Copie para .env na raiz do projeto: cp .env.example .env
# =====================================================================

# ---------- PostgreSQL (docker compose) ----------
POSTGRES_DB=login_jwt_db
POSTGRES_USER=login_jwt_user
POSTGRES_PASSWORD=login_jwt_pass
POSTGRES_PORT=5433

# ---------- Backend: Spring datasource ----------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/login_jwt_db
SPRING_DATASOURCE_USERNAME=login_jwt_user
SPRING_DATASOURCE_PASSWORD=login_jwt_pass

# ---------- Backend: JWT ----------
JWT_SECRET=change-me-in-production-this-should-be-a-long-random-string
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---------- Backend: E-mail (SMTP) - obrigatorio para registro e recuperacao de senha ----------
# Para Gmail, use uma "senha de app": https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Compartilhado (backend + frontend) ----------
# Validade dos codigos de verificacao (cadastro e recuperacao de senha), em segundos
VERIFICATION_CODE_EXPIRATION_SECONDS=60
# Tamanho do codigo de verificacao
VERIFICATION_CODE_LENGTH=5

# ---------- Frontend (Angular) ----------
# Prefixo das chamadas a API (o proxy de dev remove o prefixo ao encaminhar)
API_BASE=/api
# URL do backend usada pelo proxy de dev (ng serve)
BACKEND_URL=http://localhost:8080
