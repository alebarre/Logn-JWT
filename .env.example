# PostgreSQL
POSTGRES_DB=login_jwt_db
POSTGRES_USER=login_jwt_user
POSTGRES_PASSWORD=login_jwt_pass
POSTGRES_PORT=5433

# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/login_jwt_db
SPRING_DATASOURCE_USERNAME=login_jwt_user
SPRING_DATASOURCE_PASSWORD=login_jwt_pass

# JWT
JWT_SECRET=change-me-in-production-this-should-be-a-long-random-string
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
